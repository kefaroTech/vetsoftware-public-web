# Public client-side values only. Never store secrets in Vite environment files.
VETSOFTWARE_PROFILE=localdev
VITE_API_URL=http://localhost:8080
VITE_LOGIN_URL=http://localhost:5173/login
VITE_RECAPTCHA_SITE_KEY=

# TR-05 · Telemetría del navegador (Grafana Faro). Sin valor no se activa nada y el bundle no
# crece: Vite elimina el import() en compilación. En prod el colector (Alloy) vive en un
# registro DNS interno, así que exponerlo es una decisión de plataforma pendiente.
VITE_TELEMETRY_URL=
